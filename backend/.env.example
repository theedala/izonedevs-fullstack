# Environment variables for FastAPI backend
DATABASE_URL=postgresql://user:password@localhost/izonedevs
ENVIRONMENT=development
SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Email configuration (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# File upload settings
MAX_FILE_SIZE=10485760  # 10MB
UPLOAD_DIR=uploads

# S3-compatible object storage (MinIO in Docker)
S3_ENDPOINT_URL=http://localhost:9000
S3_PUBLIC_URL=http://localhost:9000
S3_BUCKET=izonedevs
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin123
S3_REGION=us-east-1
S3_SECURE=false

# CORS settings
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Runtime settings (set ENVIRONMENT=production only with a strong SECRET_KEY)
DEBUG=False
